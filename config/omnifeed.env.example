# =============================================================================
# OmniFeed 统一环境变量配置
# =============================================================================
#
# 本地开发:
#   cp config/omnifeed.env.example .env
#   # 编辑 .env 填入真实值
#
# GitHub Actions:
#   见 config/README.md — 在仓库 Settings → Secrets 中配置
#
# 前端 config.js 生成:
#   python scripts/generate_frontend_config.py
#
# Cloudflare Worker secrets (wrangler):
#   cd worker && npx wrangler secret put TURNSTILE_SECRET_KEY
#   cd worker && npx wrangler secret put ALLOWED_ORIGIN
# =============================================================================

# -----------------------------------------------------------------------------
# ETL 管道 (GitHub Actions: etl-pipeline.yml)
# -----------------------------------------------------------------------------

# 是否跳过 R2 写入（本地调试 / 手动 dry run）
DRY_RUN=false

# 数据回溯天数、Feed 最大保留条数
ETL_DAYS_BACK=7
ETL_MAX_FEED_ITEMS=500

# -----------------------------------------------------------------------------
# FMP API — Financial Modeling Prep
# 文档: https://site.financialmodelingprep.com/developer/docs
# 内幕交易: stable/insider-trading/search (主) / api/v4/insider-trading (备)
# 股票新闻: stable/news/stock (主) / api/v3/stock_news (备)
# -----------------------------------------------------------------------------

FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_V4_BASE_URL=https://financialmodelingprep.com/api/v4
FMP_V3_BASE_URL=https://financialmodelingprep.com/api/v3
FMP_INSIDER_LIMIT=100
FMP_NEWS_LIMIT=100

# -----------------------------------------------------------------------------
# Quiver Quantitative — 国会交易数据（可选，不配则走 Capitol Trades 免费源）
# -----------------------------------------------------------------------------

QUIVER_API_KEY=

# -----------------------------------------------------------------------------
# LLM 网关 — DeepSeek / OpenAI 兼容接口
# -----------------------------------------------------------------------------

LLM_MODE=SDK_MODE
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CHUNK_SIZE=10
LLM_MAX_FAILURES=3

# -----------------------------------------------------------------------------
# Cloudflare R2 对象存储
# -----------------------------------------------------------------------------

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=omnifeed-bucket

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — 人机验证
# site_key 给前端，secret_key 给 Worker
# -----------------------------------------------------------------------------

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 前端部署 (GitHub Actions: deploy-frontend.yml → 生成 frontend/config.js)
# -----------------------------------------------------------------------------

# Worker API 地址（含 /api 路径，无尾部斜杠）
OMNIFEED_API_BASE=https://omnifeed-worker.your-subdomain.workers.dev/api

# R2 公开访问域名（无尾部斜杠）
OMNIFEED_FEEDS_BASE=https://pub-xxxxxxxx.r2.dev

# -----------------------------------------------------------------------------
# Cloudflare 部署凭证 (GitHub Actions: deploy-frontend.yml / deploy-worker.yml)
# 仅需在 GitHub Secrets 配置，本地一般不需要
# -----------------------------------------------------------------------------

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Cloudflare Worker 额外 CORS 域名（可选，逗号分隔，wrangler secret 注入）
# -----------------------------------------------------------------------------

# ALLOWED_ORIGIN=https://your-custom-domain.com
